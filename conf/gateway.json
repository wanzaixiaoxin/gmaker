{
  "service": {
    "service_type": "gateway",
    "node_id": "gateway-1",
    "log_level": "info",
    "log_file": "",
    "metrics_addr": ":9081"
  },
  "network": {
    "port": 8081,
    "websocket_port": 8083,
    "kcp_port": 8084,
    "udp_port": 8085,
    "max_connections": 10000
  },
  "kcp": {
    "interval_ms": 10,
    "nodelay": 1,
    "resend": 2,
    "nc": 1
  },
  "udp": {
    "session_timeout_ms": 30000
  },
  "discovery": {
    "type": "registry",
    "addrs": ["127.0.0.1:2379"]
  },
  "upstream": {
    "services": ["biz", "chat", "login"]
  },
  "coalescer_interval_ms": 16,
  "security": {
    "master_key_hex": "",
    "replay_window_seconds": 300
  }
}
